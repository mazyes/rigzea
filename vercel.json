{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "rigzea",
  "buildCommand": "node scripts/stamp-assets.mjs && node scripts/generate-sitemap.mjs",
  "cleanUrls": true,
  "trailingSlash": true,
  "functions": {
    "api/p.js": {
      "includeFiles": "rigzea/{p/index.html,js/config.js}"
    },
    "api/import-listing.js": {
      "includeFiles": "rigzea/js/config.js"
    },
    "api/plan-email.js": {
      "includeFiles": "rigzea/js/config.js"
    },
    "api/cron-reminders.js": {
      "maxDuration": 60,
      "includeFiles": "rigzea/js/config.js"
    },
    "api/telegram.js": {
      "includeFiles": "rigzea/js/config.js"
    },
    "api/link-event.js": {
      "includeFiles": "rigzea/js/config.js"
    },
    "api/kisa-checkout.js": {
      "includeFiles": "rigzea/js/config.js"
    },
    "api/kisa-webhook.js": {
      "includeFiles": "rigzea/js/config.js"
    },
    "api/kisa-stream-confirm.js": {
      "includeFiles": "rigzea/js/config.js"
    }
  },
  "redirects": [
    {
      "source": "/p/",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>[A-Za-z0-9-]{3,80})"
        }
      ],
      "destination": "/p/:id/",
      "permanent": false
    },
    {
      "source": "/p",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>[A-Za-z0-9-]{3,80})"
        }
      ],
      "destination": "/p/:id/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/p/:ref([A-Za-z0-9-]{3,80})/",
      "destination": "/api/p?ref=:ref"
    },
    {
      "source": "/p/:ref([A-Za-z0-9-]{3,80})",
      "destination": "/api/p?ref=:ref"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|html)",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(app|js)/(.*)\\.(js|css)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!app/|js/).*)\\.(js|css|html)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-reminders/",
      "schedule": "0 5 * * *"
    }
  ]
}
